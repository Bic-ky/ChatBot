# Environment Configuration Template
PROJECT_NAME="ChatBot AI Business Assistant"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api/v1"

# Database (PostgreSQL + pgvector)
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="changethisinproduction"
POSTGRES_DB="chatbot"
DATABASE_URL="postgresql+asyncpg://postgres:changethisinproduction@localhost:5432/chatbot"

# Redis Cache & Broker
REDIS_URL="redis://localhost:6379/0"

# Celery Worker
CELERY_BROKER_URL="redis://localhost:6379/1"
CELERY_RESULT_BACKEND="redis://localhost:6379/2"

# Security & Authentication
SECRET_KEY="generate_a_secure_random_key_for_production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# LLM Providers (OpenAI / Anthropic / Gemini / Local)
DEFAULT_LLM_PROVIDER="openai"
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GEMINI_API_KEY=""

# Vector & Embeddings
EMBEDDING_MODEL="text-embedding-3-small"
EMBEDDING_DIMENSION=1536

# Web Search Provider (Tavily / Serper / Brave)
SEARCH_PROVIDER="tavily"
TAVILY_API_KEY=""

# CORS & Allowed Origins
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]
